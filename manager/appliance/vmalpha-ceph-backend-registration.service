[Unit]
Description=Register fresh verified VM Alpha Ceph backend state
Wants=network-online.target
After=network-online.target vmalpha-manager.service
ConditionPathExists=/var/lib/vmalpha/storage-registration.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/vmalpha-register-ceph-backends --manifest /var/lib/vmalpha/storage-registration.json
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/vmalpha-manager
UMask=0077
